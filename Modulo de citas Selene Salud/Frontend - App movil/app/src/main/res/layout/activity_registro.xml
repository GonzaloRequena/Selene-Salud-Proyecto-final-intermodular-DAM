<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA"
    tools:context=".ui.RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Paciente"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta de Selene Salud"
            android:textSize="15sp"
            android:textColor="#757575"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/etRegistroDni"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="DNI o NIE *"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Nombre *"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroApellidos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Apellidos *"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroTelefono"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Teléfono móvil"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Correo electrónico *"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Contraseña *"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnConfirmarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar Registro"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBarRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="#1A237E"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>