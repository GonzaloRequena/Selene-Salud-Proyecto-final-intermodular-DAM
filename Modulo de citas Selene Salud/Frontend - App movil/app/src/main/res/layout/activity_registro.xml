<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    tools:context=".ui.RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="250dp"
            android:layout_height="80dp"
            android:src="@drawable/logo3"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Selene Salud"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_de_paciente"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crea_tu_cuenta_de_selene_salud"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/etRegistroDni"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/dni_o_nie"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/nombre"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroApellidos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/apellidos"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroTelefono"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/telefono_movil"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/correo_electronico2"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etRegistroPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/contrasena2"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="@color/brand_primary_light"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnConfirmarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/confirmar_registro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBarRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/brand_primary"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>