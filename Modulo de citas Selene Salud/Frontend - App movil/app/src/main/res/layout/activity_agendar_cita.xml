<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainAgendarCita"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FDFBFF">

    <TextView
        android:id="@+id/tvTituloPaso3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paso 3: Selecciona Fecha y Hora"
        android:textColor="#0061A4"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvMedicoSeleccionado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cita con: Dr. Nombre Apellido"
        android:textColor="#41474D"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <CalendarView
        android:id="@+id/calendarViewCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:color/white"
        android:elevation="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una hora disponible:"
        android:textStyle="bold"
        android:textColor="#41474D"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerHoras"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/white"
        android:elevation="1dp"/>

    <Button
        android:id="@+id/btnConfirmarCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar y Agendar Cita"
        android:backgroundTint="#0061A4"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:padding="12dp"/>
</LinearLayout>