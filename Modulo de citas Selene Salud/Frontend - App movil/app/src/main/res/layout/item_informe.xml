<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://androidx.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvFechaInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/consulta_10_06_2026"
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvMedicoInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emitido_por_dr_manuel_garc_a"
            android:textColor="#001E35"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E1E2EC"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostico"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/faringitis_aguda_bacteriana"
            android:textColor="#1A1C1E"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tratamiento_prescrito"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amoxicilina_500mg_cada_8_horas_durante_7_d_as"
            android:textColor="#1A1C1E"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/observaciones"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reposo_e_hidrataci_n_constante_volver_si_empeora"
            android:textColor="#41474D"
            android:textSize="13sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>